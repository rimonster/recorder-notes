{
  "name": "@headarcade/recorder-notes",
  "version": "0.1.0",
  "description": "Soprano recorder notes and fingerings (baroque and German), a pitch detector for the recorder, and sheet music as SVG. By Head Arcade.",
  "keywords": [
    "recorder",
    "soprano recorder",
    "descant recorder",
    "fingering",
    "pitch detection",
    "music education",
    "sheet music",
    "svg",
    "web audio"
  ],
  "license": "MIT",
  "author": "Head Arcade (https://headarcade.com)",
  "homepage": "https://recorderhero.com/recorder-fingering-chart/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rimonster/recorder-notes.git"
  },
  "bugs": {
    "url": "https://github.com/rimonster/recorder-notes/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/*.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
